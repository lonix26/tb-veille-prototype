    {
      "parameters": {
        "jsCode": "// Normalisation des scores, et contrôles AVANT écriture.\n//\n// Quatre garde-fous repris du script, tous destinés à empêcher qu'une sortie de\n// modèle entre au registre sans être bornée :\n//   · seuls les item_id RÉELLEMENT soumis dans le lot sont acceptés ;\n//   · la pertinence doit valoir 0, 1 ou 2 — jamais de score par défaut ;\n//   · le secteur doit appartenir aux quatre codes de la grille, sinon null ;\n//   · la question de veille doit appartenir à QV1..QV5, sinon null.\n// Antériorité et portée ne sont écrites qu'en doctrine « signal » : les\n// renseigner en doctrine « evenement » leur donnerait une valeur que la\n// consigne n'a jamais demandée.\nconst SECTEURS = new Set(['horlogerie','medical','automobile','aerospatial']);\nconst QVS = new Set(['QV1','QV2','QV3','QV4','QV5']);\nconst borne = v => ([0,1,2].indexOf(v) !== -1 ? v : null);\n\nconst sorties = [], incidents = [];\n// Le marqueur posé en amont quand il n'y a rien à traiter traverse sans écrire.\nif ($input.all().some(x => x.json && x.json._rien_a_faire)) {\n  return [{ json: { _rien_a_faire: true, _incidents: [] } }];\n}\nconst lignes = $input.all();\nfor (let i = 0; i < lignes.length; i++) {\n  const r = lignes[i].json;\n  const t = $('Préparer les lots').itemMatching(i).json;\n  if (r.error) { incidents.push('lot ' + (i+1) + ' : appel en échec (' + JSON.stringify(r.error).slice(0,150) + ')'); continue; }\n  const parts = (r && r.candidates && r.candidates[0] && r.candidates[0].content && r.candidates[0].content.parts) || [];\n  const brut = parts.filter(p => p.text).map(p => p.text).join('\\n').trim();\n  if (!brut) { incidents.push('lot ' + (i+1) + ' : réponse sans texte'); continue; }\n  const m = /```(?:json)?\\s*(\\{[\\s\\S]*\\})\\s*```/.exec(brut);\n  let rep;\n  try { rep = JSON.parse(m ? m[1] : brut); }\n  catch (e) { incidents.push('lot ' + (i+1) + ' : JSON non parsable'); continue; }\n  // Les identifiants viennent de Postgres en CHAÎNE (bigint sérialisé) et\n  // reviennent du modèle en NOMBRE : sans normalisation des deux côtés, la\n  // totalité des scores est rejetée comme « hors lot ». Constaté au premier\n  // essai — 2208 items écartés, zéro écrit.\n  const admis = new Set(t.ids.map(String));\n  for (const x of (rep.triages || [])) {\n    if (!admis.has(String(x.item_id))) { incidents.push('item hors lot ignoré : ' + x.item_id); continue; }\n    if ([0,1,2].indexOf(x.pertinence) === -1) { incidents.push('pertinence hors barème pour ' + x.item_id); continue; }\n    sorties.push({ json: {\n      item_id: x.item_id,\n      modele: $env.MODELE_GOOGLE || 'gemini-3.7-flash',\n      doctrine: t.doctrine,\n      pertinence: x.pertinence,\n      anteriorite: t.doctrine === 'signal' ? borne(x.anteriorite) : null,\n      portee:      t.doctrine === 'signal' ? borne(x.portee)      : null,\n      sector_code: SECTEURS.has(x.secteur) ? x.secteur : null,\n      watch_question_code: QVS.has(x.qv) ? x.qv : null,\n      resume: (x.resume || '').slice(0,500),\n      justification: (x.justification || '').slice(0,500),\n      _incidents: incidents, _doctrine: t.doctrine\n    }});\n  }\n}\nif (!sorties.length) throw new Error('aucun score exploitable — incidents : ' + (incidents.join(' | ') || 'aucun'));\nreturn sorties;"
      },
      "id": "normaliser-et-controler",
      "name": "Normaliser et controler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
