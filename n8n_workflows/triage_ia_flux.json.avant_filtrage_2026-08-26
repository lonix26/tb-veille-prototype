    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.MODELE_GOOGLE || 'gemini-3.7-flash' }}:generateContent",
        "sendHeaders": true,
