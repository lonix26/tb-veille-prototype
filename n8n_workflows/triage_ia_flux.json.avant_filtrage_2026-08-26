    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE runs SET status = CASE WHEN $2::int = 0 THEN 'echec' WHEN $4::int > 0 THEN 'partiel' ELSE 'ok' END, closed_at = now(), note = $3 WHERE run_id = $1 RETURNING run_id, status, note;",
        "options": {
          "queryReplacement": "={{ (() => { let ecrits = 0; try { ecrits = $('Écrire les scores').all().length; } catch (e) { ecrits = 0; } const items = $('Normaliser et controler').all().map(x => x.json); const inc = (items[0] && items[0]._incidents) || []; const doc = (items[0] && items[0]._doctrine) || '?'; const note = 'Triage IA des flux — ' + ecrits + ' score(s) ecrit(s), doctrine ' + doc + '.' + (inc.length ? ' Incidents : ' + inc.join(' | ') + '.' : ''); return [ $('Ouvrir le run').first().json.run_id, ecrits, note, inc.length ]; })() }}"
        }
