    {
      "parameters": {
        "jsCode": "// Une requête par flux ACTIF, quelle que soit sa famille.\n//\n// Architecture reprise du collecteur générique : UNE préparation, deux appels\n// selon la méthode, UNE normalisation. Quatre branches parallèles auraient\n// dupliqué la trace d'audit et la clôture du run.\n//\n// Le filtrage sur `statut = 'actif'` est fait par la requête amont : la règle du\n// § 10.4 — aucune liaison ne collecte sans qualification humaine nominative —\n// est exercée par le SQL, pas seulement déclarée au référentiel.\nconst runId = $('Ouvrir le run').first().json.run_id;\nconst auj = new Date();\nconst jj = d => '' + d.getUTCFullYear() + String(d.getUTCMonth()+1).padStart(2,'0')\n                 + String(d.getUTCDate()).padStart(2,'0');\nconst ilYa = n => jj(new Date(auj.getTime() - n*86400000));\n\nconst sorties = [];\nfor (const item of $input.all()) {\n  const f = item.json;\n  const p = typeof f.parametres === 'string' ? JSON.parse(f.parametres) : (f.parametres ?? {});\n  const commun = { run_id: runId, flux_id: f.flux_id, famille: f.famille,\n                   sector_code: f.sector_code, parametres: p };\n\n  if (f.famille === 'marches_publics') {\n    // TED : POST JSON, sans clé.\n    sorties.push({ json: { ...commun, methode: 'POST', url: f.url_base,\n      corps: { query: `classification-cpv IN (${p.cpv}) AND publication-date >= ${ilYa(p.fenetre_jours ?? 30)} `\n                    + `AND publication-date < ${jj(auj)}`,\n               limit: p.limite ?? 50,\n               fields: ['publication-number','notice-title','publication-date','buyer-name'] } }});\n\n  } else if (f.famille === 'actualite') {\n    // GDELT : GET, sans clé. Les paramètres partent en chaîne de requête.\n    // URLSearchParams n'existe pas dans les nœuds Code de l'orchestrateur : la\n    // chaîne de requête est construite à la main, avec encodage explicite.\n    const qs = [['query', p.requete], ['mode','ArtList'], ['format','json'],\n                ['maxrecords', String(p.limite ?? 50)], ['timespan', p.fenetre ?? '7d']]\n      .map(([k, v]) => k + '=' + encodeURIComponent(v)).join('&');\n    sorties.push({ json: { ...commun, methode: 'GET', url: f.url_base + '?' + qs }});\n\n  } else if (f.famille === 'reglementaire') {\n    // openFDA : PIÈGE D'ENCODAGE. La syntaxe d'intervalle est `champ:[debut+TO+fin]`\n    // et le signe + ne doit PAS être encodé — passé en paramètre de requête, il\n    // devient %2B et l'API répond 500, diagnostic trompeur qui ressemble à une\n    // panne du service. L'URL est donc construite entière, à dessein.\n    const url = f.url_base + '?search=' + p.champ_date + ':[' + ilYa(p.fenetre_jours ?? 30)\n              + '+TO+' + jj(auj) + ']&limit=' + (p.limite ?? 50);\n    sorties.push({ json: { ...commun, methode: 'GET', url }});\n\n  } else if (f.famille === 'communications') {\n    // Fil de syndication : GET, réponse XML lue en texte.\n    sorties.push({ json: { ...commun, methode: 'GET', url: f.url_base }});\n  }\n}\nif (!sorties.length) throw new Error('aucun flux actif — vérifier flux_sources.statut');\nreturn sorties;"
      },
