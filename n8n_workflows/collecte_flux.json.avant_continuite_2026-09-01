    {
      "parameters": {
        "jsCode": "// Normalisation de toutes les familles vers une forme unique.\n//\n// L'empreinte est la clé de déduplication du registre : elle est calculée sur\n// le flux et l'identifiant naturel de l'item — numéro d'avis, URL d'article,\n// identifiant réglementaire. Deux exécutions successives ne créent donc pas de\n// doublon, ce qui est la condition pour rejouer le workflow sans précaution.\nconst sorties = [], incidents = [];\n\nconst { createHash } = require('crypto');\nfunction empreinte(...parts) {\n  // EMPREINTE SHA-256, identique à celle du script qu'il remplace.\n  //\n  // Le premier jet employait un condensé lisible maison, au motif — FAUX — que\n  // les nœuds Code n'exposent pas `crypto`. Vérifié : `require('crypto')` y\n  // fonctionne. Conséquence de l'erreur, constatée à la première exécution de\n  // bout en bout : les 663 items déjà au registre ont reçu de NOUVELLES\n  // empreintes, la déduplication n'a plus rien reconnu, et 509 doublons ont été\n  // écrits. Le workflow annonçait « 1 item nouveau » pendant qu'il en insérait\n  // cinq cents — le bilan portait sur les seuls items du dernier appel.\n  //\n  // La forme est donc figée : sha256 des parties jointes par « | », telle quelle.\n  return createHash('sha256').update(parts.map(x => String(x)).join('|')).digest('hex');\n}\nconst txt = v => {\n  if (v === null || v === undefined) return '';\n  if (typeof v === 'string') return v;\n  if (Array.isArray(v)) return v.length ? txt(v[0]) : '';\n  if (typeof v === 'object') {\n    // TED rend ses titres en dictionnaire de langues. La clé française est\n    // « fra » (ISO 639-2/T) et non « fre » — avec « fre », le code retombait\n    // silencieusement sur l'anglais.\n    for (const lg of ['fra','eng','deu','mul']) if (v[lg]) return txt(v[lg]);\n    for (const x of Object.values(v)) { const r = txt(x); if (r) return r; }\n  }\n  return String(v);\n};\nconst dateIso = brute => {\n  // openFDA sert ses dates tantôt en AAAAMMJJ, tantôt en AAAA-MM-JJ selon le\n  // point d'accès. Normaliser sur les CHIFFRES évite de découper une chaîne\n  // déjà ponctuée — ce qui produisait « 2026--0-8- » et faisait échouer tout\n  // le chargement sur un « datestyle » incompréhensible.\n  const c = String(brute ?? '').replace(/\\D/g, '');\n  return c.length >= 8 ? c.slice(0,4) + '-' + c.slice(4,6) + '-' + c.slice(6,8) : null;\n};\n\nconst lignes = $input.all();\nfor (let i = 0; i < lignes.length; i++) {\n  const rep = lignes[i].json;\n  const t = $('Préparer les requêtes').itemMatching(i).json;\n  const corps = typeof rep.data === 'string' ? rep.data : (typeof rep === 'string' ? rep : JSON.stringify(rep));\n  const raw = 'run ' + t.run_id + ' · ' + t.flux_id;\n\n  if (t.famille === 'communications') {\n    // Fil de syndication : extraction par expression régulière plutôt que par\n    // analyseur XML, absent des nœuds Code. Les fils RSS sont réguliers.\n    const blocs = corps.match(/<item[\\s\\S]*?<\\/item>/gi) || [];\n    for (const b of blocs) {\n      const g = (bal) => { const m = new RegExp('<' + bal + '[^>]*>([\\\\s\\\\S]*?)<\\\\/' + bal + '>', 'i').exec(b);\n        return m ? m[1].replace(/<!\\[CDATA\\[|\\]\\]>/g, '').trim() : ''; };\n      const titre = g('title'), lien = g('link'), pub = g('pubDate');\n      if (!titre) continue;\n      const d = pub ? new Date(pub) : null;\n      sorties.push({ json: { flux_id: t.flux_id,\n        date_publication: (d && !isNaN(d)) ? d.toISOString().slice(0,10) : null,\n        titre: titre.slice(0,500), url: lien || null,\n        payload: JSON.stringify({ titre, lien, pub }),\n        empreinte: empreinte(t.flux_id, lien || titre), raw_ref: raw, _flux: t.flux_id }});\n    }\n    continue;\n  }\n\n  // openFDA répond 404 quand la recherche ne ramène RIEN : ce n'est pas une\n  // panne, et le traiter comme telle ferait passer une fenêtre vide pour un\n  // flux défaillant.\n  if (rep.error || (rep.statusCode && rep.statusCode >= 400)) {\n    const code = rep.statusCode ?? (rep.error && rep.error.httpCode);\n    if (String(code) === '404' && t.famille === 'reglementaire') {\n      incidents.push(t.flux_id + ' : fenêtre vide (404 openFDA = recherche sans résultat, pas une panne)');\n    } else {\n      incidents.push(t.flux_id + ' : appel en échec (HTTP ' + code + ')');\n    }\n    continue;\n  }\n\n  let j;\n  try { j = JSON.parse(corps); }\n  catch (e) {\n    // GDELT refuse la cadence sous DEUX formes : un 429, et — plus traître —\n    // un HTTP 200 dont le corps est le message en clair « Please limit requests\n    // to one every 5 seconds ». Ne tester que le code de statut laisserait\n    // passer la seconde, et le flux serait classé en échec de format alors\n    // qu'il s'agit d'une cadence.\n    if (/limit requests/i.test(corps)) incidents.push(t.flux_id + ' : cadence refusée par la source — relancer le workflow plus tard');\n    else incidents.push(t.flux_id + ' : réponse non-JSON (' + corps.slice(0,60) + ')');\n    continue;\n  }\n\n  if (t.famille === 'marches_publics') {\n    for (const a of (j.notices ?? [])) {\n      const num = a['publication-number'] ?? '';\n      sorties.push({ json: { flux_id: t.flux_id,\n        date_publication: String(a['publication-date'] ?? '').slice(0,10) || null,\n        titre: ('[TED ' + num + '] ' + txt(a['notice-title'])).slice(0,500),\n        url: num ? 'https://ted.europa.eu/fr/notice/-/detail/' + num : null,\n        payload: JSON.stringify(a), empreinte: empreinte(t.flux_id, num),\n        raw_ref: raw, _flux: t.flux_id }});\n    }\n  } else if (t.famille === 'actualite') {\n    for (const art of (j.articles ?? [])) {\n      const u = art.url ?? '';\n      const d = String(art.seendate ?? '').slice(0,8);\n      sorties.push({ json: { flux_id: t.flux_id,\n        date_publication: d.length === 8 ? d.slice(0,4)+'-'+d.slice(4,6)+'-'+d.slice(6,8) : null,\n        titre: (art.title || '(sans titre)').slice(0,500), url: u || null,\n        payload: JSON.stringify({ title: art.title, url: u, domain: art.domain,\n                                  language: art.language, seendate: art.seendate,\n                                  sourcecountry: art.sourcecountry }),\n        empreinte: empreinte(t.flux_id, u), raw_ref: raw, _flux: t.flux_id }});\n    }\n  } else if (t.famille === 'reglementaire') {\n    const p = t.parametres;\n    for (const res of (j.results ?? [])) {\n      const ident = res[p.champ_id] ?? '';\n      const lib = res[p.champ_libelle] ?? '';\n      const acteur = p.champ_acteur ? (res[p.champ_acteur] ?? '') : '';\n      sorties.push({ json: { flux_id: t.flux_id,\n        date_publication: dateIso(res[p.champ_date]),\n        titre: ('[' + p.prefixe + ' ' + ident + '] ' + lib + (acteur ? ' — ' + acteur : '')).slice(0,500),\n        url: p.url_detail ? String(p.url_detail).replace('{ident}', ident) : null,\n        payload: JSON.stringify(res), empreinte: empreinte(t.flux_id, ident),\n        raw_ref: raw, _flux: t.flux_id }});\n    }\n  }\n}\nif (!sorties.length) throw new Error('aucun item collecté — incidents : ' + (incidents.join(' | ') || 'aucun'));\nsorties.forEach(s => { s.json._incidents = incidents; });\nreturn sorties;"
      },
