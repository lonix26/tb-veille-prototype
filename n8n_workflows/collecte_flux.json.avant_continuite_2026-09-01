      "id": "lire-les-flux-actifs",
      "name": "Lire les flux actifs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "QdVRYX9pjTj9C8G3",
          "name": "postgres veille"
        }
