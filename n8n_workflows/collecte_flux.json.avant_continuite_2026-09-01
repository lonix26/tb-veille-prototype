    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Seules les liaisons QUALIFIÉES collectent (§ 10.4). Les familles écartées\n-- — marchés financiers, symboles inaccessibles — ne sortent pas d'ici.\nSELECT flux_id, famille, sector_code, url_base, parametres\nFROM flux_sources WHERE statut = 'actif' ORDER BY famille, flux_id;",
