        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contents:[{parts:[{text: $('Cadrer le besoin de veille').first().json.prompt + ' Besoin: ' + $('Cadrer le besoin de veille').first().json.intitule_besoin + ' Secteur: ' + $('Cadrer le besoin de veille').first().json.secteur + ' Périmètre: ' + $('Cadrer le besoin de veille').first().json.perimetre_geo + ' Critères: ' + JSON.stringify($('Cadrer le besoin de veille').first().json.criteres_admissibilite)}]}]}) }}"
      },
      "name": "Modèle C (Google)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 500],
