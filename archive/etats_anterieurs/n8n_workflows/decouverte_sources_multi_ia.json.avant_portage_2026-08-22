    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'sonar-pro', temperature:0, messages:[{role:'user', content: $('Cadrer le besoin de veille').first().json.prompt + ' Besoin: ' + $('Cadrer le besoin de veille').first().json.intitule_besoin + ' Secteur: ' + $('Cadrer le besoin de veille').first().json.secteur + ' Périmètre: ' + $('Cadrer le besoin de veille').first().json.perimetre_geo + ' Critères: ' + JSON.stringify($('Cadrer le besoin de veille').first().json.criteres_admissibilite)}]}) }}"
      },
      "name": "Modèle D (Perplexity)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 700],
      "notes": "Modèle adossé à la recherche web : sert de contrepoint aux modèles répondant de mémoire."
    },
    {
      "parameters": {
        "jsCode": "// Fusion des propositions, normalisation des URL et calcul du recouvrement inter-modèles.\n// Le recouvrement est un signal de priorisation, jamais une preuve : la vérification objective suit (§ 6.3).\nconst MODELES = ['openai', 'anthropic', 'google', 'perplexity'];\n\nfunction texte(x) {\n  return x.choices?.[0]?.message?.content\n      ?? x.content?.[0]?.text\n      ?? x.candidates?.[0]?.content?.parts?.[0]?.text\n      ?? '';\n}\nfunction parser(t) {\n  try { return (JSON.parse(String(t).replace(/^```json/i, '').replace(/```$/, '').trim()).sources) || []; }\n  catch (e) { return []; }\n}\nfunction cle(u) {\n  try { const p = new URL(u); return (p.hostname.replace(/^www\\./, '') + p.pathname.replace(/\\/$/, '')).toLowerCase(); }\n  catch (e) { return String(u || '').toLowerCase().trim(); }\n}\n\nconst registre = {};\n$input.all().forEach((item, i) => {\n  const modele = MODELES[i] || ('modele_' + i);\n  for (const s of parser(texte(item.json))) {\n    const k = cle(s.url);\n    if (!k) continue;\n    if (!registre[k]) registre[k] = { cle: k, url: s.url, nom: s.nom, organisme: s.organisme, propositions: {}, modeles: [] };\n    registre[k].propositions[modele] = s;\n    if (!registre[k].modeles.includes(modele)) registre[k].modeles.push(modele);\n  }\n});\n\nconst contexte = $('Cadrer le besoin de veille').first().json;\nconst candidats = Object.values(registre).map(c => ({\n  cle: c.cle,\n  url: c.url,\n  nom: c.nom,\n  organisme: c.organisme,\n  modeles: c.modeles,\n  nb_modeles: c.modeles.length,\n  indice_recouvrement: c.modeles.length / MODELES.length,\n  propositions: c.propositions,\n  secteur: contexte.secteur,\n  question_veille: contexte.question_veille,\n  intitule_besoin: contexte.intitule_besoin\n})).sort((a, b) => b.nb_modeles - a.nb_modeles);\n\nconst union = candidats.length;\nconst noyau = candidats.filter(c => c.nb_modeles >= 3).length;\nreturn [{ json: {\n  releve_le: new Date().toISOString(),\n  union_propositions: union,\n  noyau_commun: noyau,\n  indice_recouvrement_global: union ? noyau / union : 0,\n  candidats\n} }];"
      },
      "name": "Normaliser et recouper les propositions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 400],
      "notes": "Produit l'indice de recouvrement du § 9.2 appliqué à la tâche d'identification de sources."
    },
    {
      "parameters": {
        "fieldToSplitOut": "candidats",
        "options": {}
      },
      "name": "Éclater les candidats",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true } },
          "timeout": 15000,
          "redirect": { "redirect": { "followRedirects": true } }
        }
      },
      "name": "Vérifier l'existence de l'URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 400],
      "onError": "continueRegularOutput",
      "notes": "Contrôle objectif : une URL inatteignable est écartée quel que soit le nombre de modèles l'ayant proposée. C'est ce contrôle, et non le consensus, qui borne l'hallucination sur cette tâche."
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            { "value1": "={{ $json.statusCode || 0 }}", "operation": "largerEqual", "value2": 200 },
            { "value1": "={{ $json.statusCode || 0 }}", "operation": "smaller", "value2": 400 }
          ]
        },
        "combineOperation": "all"
      },
      "name": "URL joignable ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1640, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Fiche de qualification pré-remplie, alignée sur la table `indicators` du schéma consolidé.\n// Les champs de décision restent vides : le workflow prépare la décision, il ne la prend pas.\n// Le nœud HTTP précédent ne renvoie que la réponse ; les données du candidat sont reprises par appariement d'items.\nconst cand = $('Éclater les candidats').item.json;\nconst brut = $('Lire le référentiel existant').all().map(i => i.json);\nconst referentiel = Array.isArray(brut[0]) ? brut[0] : brut;\n\nfunction cle(u) {\n  try { const p = new URL(u); return (p.hostname.replace(/^www\\./, '') + p.pathname.replace(/\\/$/, '')).toLowerCase(); }\n  catch (e) { return String(u || '').toLowerCase().trim(); }\n}\nconst dejaConnues = new Set(referentiel.map(r => cle(r.source_url)));\n\nif (dejaConnues.has(cand.cle)) {\n  return { json: {\n    statut_traitement: 'doublon_referentiel',\n    motif: 'Source déjà inscrite au référentiel',\n    source_url: cand.url,\n    nb_modeles: cand.nb_modeles,\n    modeles: cand.modeles,\n    constate_le: new Date().toISOString()\n  } };\n}\n\nconst props = Object.values(cand.propositions || {});\nconst consensuel = (champ) => {\n  const vals = props.map(p => String(p?.[champ] ?? '').trim().toLowerCase()).filter(Boolean);\n  return vals.length && vals.every(x => x === vals[0]) ? vals[0] : null;\n};\n\nreturn { json: {\n  statut_traitement: 'a_qualifier',\n  // Identification\n  source_name: cand.organisme || cand.nom || null,\n  source_url: cand.url,\n  sector: cand.secteur,\n  watch_question: cand.question_veille,\n  besoin: cand.intitule_besoin,\n  // Proposé par les modèles, à confirmer par l'humain (null si les modèles divergent)\n  frequency_proposee: consensuel('frequence'),\n  format_propose: consensuel('format'),\n  acces_propose: consensuel('acces'),\n  indicateur_couvert_propose: props.map(p => p?.indicateur_couvert).filter(Boolean),\n  justifications: props.map(p => p?.justification).filter(Boolean),\n  // Preuves accompagnant la fiche\n  nb_modeles: cand.nb_modeles,\n  modeles: cand.modeles,\n  indice_recouvrement: cand.indice_recouvrement,\n  url_verifiee: true,\n  http_status: $json.statusCode ?? null,\n  verifiee_le: new Date().toISOString(),\n  // Champs de décision, laissés vides à dessein\n  category: null,\n  status: null,\n  decision: null,\n  decide_par: null,\n  decide_le: null\n} };"
      },
      "name": "Fiche de qualification pré-remplie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1880, 260]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.statut_traitement }}", "operation": "equal", "value2": "a_qualifier" }
          ]
        }
      },
      "name": "Nouvelle source ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2060, 260],
      "notes": "Les doublons du référentiel sont écartés de la file humaine mais journalisés : le journal de découverte trace l'intégralité de ce qui a été proposé et ce qui en a été fait."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://loader:8080/source-qualification-queue",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "name": "File de qualification humaine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2300, 160],
      "notes": "Seul point de sortie vers le référentiel : l'inscription d'une source suppose une décision humaine tracée (E6, E7)."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Journal des propositions non vérifiables : mesure directe du taux d'invention par modèle.\n// Alimente la tâche d'identification de sources du protocole expérimental (T1, § 9.1.2)\n// et le suivi de fiabilité du dispositif en régime d'exploitation.\nconst cand = $('Éclater les candidats').item.json;\nreturn { json: {\n  statut_traitement: 'non_verifiable',\n  motif: 'URL inatteignable ou inexistante à la date de vérification',\n  source_url: cand.url,\n  nom: cand.nom ?? null,\n  organisme: cand.organisme ?? null,\n  modeles_proposants: cand.modeles ?? [],\n  nb_modeles: cand.nb_modeles ?? null,\n  indice_recouvrement: cand.indice_recouvrement ?? null,\n  http_status: $json.statusCode ?? null,\n  constate_le: new Date().toISOString()\n} };"
      },
      "name": "Journaliser les propositions non vérifiables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1880, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://loader:8080/discovery-log",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Écrire au journal de découverte",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2300, 560]
    }
  ],
