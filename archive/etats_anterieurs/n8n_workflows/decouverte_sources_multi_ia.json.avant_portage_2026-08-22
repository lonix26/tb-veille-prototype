        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'claude-sonnet-5', max_tokens:2048, temperature:0, messages:[{role:'user', content: $('Cadrer le besoin de veille').first().json.prompt + ' Besoin: ' + $('Cadrer le besoin de veille').first().json.intitule_besoin + ' Secteur: ' + $('Cadrer le besoin de veille').first().json.secteur + ' Périmètre: ' + $('Cadrer le besoin de veille').first().json.perimetre_geo + ' Critères: ' + JSON.stringify($('Cadrer le besoin de veille').first().json.criteres_admissibilite)}]}) }}"
      },
      "name": "Modèle B (Anthropic)",
      "type": "n8n-nodes-base.httpRequest",
