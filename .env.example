# Copier en .env avant le premier démarrage :  cp .env.example .env
# .env ne doit jamais être versionné ni déposé avec le rapport.

POSTGRES_DB=veille
POSTGRES_USER=veille
POSTGRES_PASSWORD=changez_moi

# Chemin du fichier de clés d'API, HORS du dossier du travail (copie Drive quotidienne).
# Le compose le monte en env_file du service n8n. Il porte, une par ligne :
#   GOOGLE_API_KEY, MODELE_GOOGLE, ANTHROPIC_API_KEY, MODELE_ANTHROPIC,
#   OPENAI_API_KEY, MODELE_OPENAI, PERPLEXITY_API_KEY, MODELE_PERPLEXITY
#   et, facultatif, TRIAGE_DOCTRINE (evenement | signal).
# Voir DEPLOIEMENT.md § 1.2 pour ce que chaque variable conditionne.
# La clé Comtrade (A4, H1, H3, M1, S6) ne passe pas par ici : c'est une credential n8n (§ 1.3).
# Le pilote hard data A5 (Eurostat) n'exige aucune clé ; le reste de la collecte hard data
# n'en exige qu'une, celle de Comtrade.
CLES_API_FICHIER=/home/<utilisateur>/.config/veille_tb/cles.env
